# Opted into by the generated local presets. clangd reloads this configuration
# and stores each project's background index next to its compilation database.
string(REPLACE "'" "''" mainverte_clangd_directory "${CMAKE_BINARY_DIR}")
file(GENERATE OUTPUT "${CMAKE_SOURCE_DIR}/.clangd" CONTENT
"# Generated by the MainVerte CMake workflow. Do not edit.
CompileFlags:
  CompilationDatabase: '${mainverte_clangd_directory}'
")
unset(mainverte_clangd_directory)
