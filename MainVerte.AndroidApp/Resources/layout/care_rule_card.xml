<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:xamarin="http://schemas.xamarin.com/android/xamarin/tools"
    xamarin:managedType="Google.Android.Material.Card.MaterialCardView"
    android:id="@+id/care_rule_card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageView
            android:id="@+id/care_rule_icon"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:contentDescription="@string/care_rule_icon_content_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/care_rule_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/care_rule_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/care_rule_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/care_rule_action"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/care_rule_action_content_description"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_save"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
