<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-android'">27</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <ApplicationId Condition="'$(TargetFramework)'=='net10.0-android'">com.MainVerte.MainVerte</ApplicationId>
        <ApplicationVersion Condition="'$(TargetFramework)'=='net10.0-android'">1</ApplicationVersion>
        <ApplicationDisplayVersion Condition="'$(TargetFramework)'=='net10.0-android'">1.0</ApplicationDisplayVersion>
        <AndroidGenerateLayoutBindings Condition="'$(TargetFramework)'=='net10.0-android'">true</AndroidGenerateLayoutBindings>
    </PropertyGroup>
    <ItemGroup>
        <Folder Include="Data\Sql\" />
        <Folder Include="UserInterface\" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Data\Migrations\*.sql" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference
                Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                Version="5.6.0"
                PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
      <AdditionalFiles Include="BannedSymbols.txt">
        <Link>BannedSymbols.txt</Link>
      </AdditionalFiles>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
      <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
      <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.9.3" />
      <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
    </ItemGroup>
    <PropertyGroup>
        <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    </PropertyGroup>
</Project>
